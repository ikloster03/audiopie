{
  "name": "audiopie",
  "version": "0.6.14",
  "private": true,
  "description": "AudioPie - build m4b audiobooks from mp3 tracks with chapter editing",
  "license": "MIT",
  "author": {
    "name": "Ivan Monastyrev",
    "email": "i@ikloster.ru"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ikloster03/audiopie.git"
  },
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build": "tsc && vite build && electron-builder",
    "build:test": "cross-env DEBUG=electron-builder tsc && vite build && electron-builder --dir --config electron-builder.json -c.asar=false",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prepare": "husky",
    "preview": "vite preview",
    "sort": "npx sort-package-json",
    "typecheck": "tsc --noEmit",
    "version:major": "npx changelogen@latest --release --major --push",
    "version:minor": "npx changelogen@latest --release --minor --push",
    "version:patch": "npx changelogen@latest --release --patch --push"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "i18next": "^26.4.1",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^4.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "png-to-ico": "^3.0.2",
    "postcss-scss": "^4.0.9",
    "sass": "^1.103.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.11"
  }
}
